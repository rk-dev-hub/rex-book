# ローカル開発用のダミー値。cp .env.example .env して使う（.env はコミットしない）

# BFF（Next.js のサーバー側）から呼ぶ RexCarte API。ブラウザには出さない
REXCARTE_API_URL=http://localhost:8000

# セッション Cookie の Secure 属性。ローカル（http）のみ false、本番は true
SESSION_COOKIE_SECURE=false

# このアプリの URL。メール本文のリンクと Origin ヘッダーの検証に使う
APP_URL=http://localhost:3100
